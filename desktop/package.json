{
  "name": "transittrack-desktop",
  "version": "0.2.7",
  "private": true,
  "description": "McSween Transport Admin and Mechanic for Windows",
  "author": "McSween Transport",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test *.test.cjs",
    "build:win": "npm run build:reader && npm run test:reader && electron-builder --win nsis --x64 --publish never",
    "build:reader": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File build-reader.ps1",
    "test:reader": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File test-reader.ps1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.transittrack.desktop",
    "productName": "McSween Transport Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "updates.cjs",
      "browser-signin.cjs",
      "policy.cjs",
      "offline.html",
      "package.json",
      "assets/**",
      "device-policy.cjs",
      "setup-main.cjs",
      "setup-preload.cjs",
      "setup.html",
      "setup.css",
      "setup.js",
      "reader.ps1",
      "preload.cjs",
      "setup-launch.cjs",
      "reader-process.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TransitTrack-Desktop-Setup-${version}.${ext}",
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "McSween Transport Desktop",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "adb.exe",
          "*.dll",
          "NOTICE.txt",
          "source.properties",
          "TransitTrack-Card-Reader.exe"
        ]
      }
    ]
  }
}

<?xml version="1.0" encoding="utf-8" ?>
<!-- McSween Kiosk only: the managed bus tablet. Merged on top of
     src/main/AndroidManifest.xml. The store app (McSween Driver) never has these. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name=".MainActivity">
            <!-- Optional Home handler: selected only through Android's explicit chooser/settings. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" android:resource="@xml/tablet_usb_devices" />
            <!-- Google/Apple sign-in happens in the phone's browser, which hands
                 the (sealed) session back through com.transittrack.app://signin.
                 Keep in step with PHONE_SIGNIN_SCHEME in src/lib/phoneSignIn.js. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.transittrack.app" android:host="signin" />
            </intent-filter>
        </activity>
        <service
            android:name=".UsbAutoAcceptService"
            android:exported="true"
            android:label="@string/usb_auto_accept_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/usb_auto_accept" />
        </service>
        <receiver android:name=".TransitDeviceAdminReceiver" android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/transit_device_admin" />
            <intent-filter><action android:name="android.app.action.DEVICE_ADMIN_ENABLED" /></intent-filter>
        </receiver>
        <activity android:name=".KioskMaintenanceActivity" android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" android:label="Kiosk maintenance" />
        <service android:name=".TabletHotspotStartupService" android:exported="false" android:foregroundServiceType="systemExempted" />
        <service android:name=".KioskWatchdogService" android:exported="false" android:foregroundServiceType="systemExempted" />
        <receiver android:name=".KioskBootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <activity android:name=".TabletRecoveryActivity" android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" android:label="Kiosk recovery" />
        <activity android:name=".RearDashcamActivity" android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" android:label="Rear dashcam" />
        <service android:name=".RearDashcamService" android:exported="false" android:foregroundServiceType="camera" />
        <service android:name=".SupportProjectionService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <receiver android:name=".NativeUpdateReceiver" android:exported="false" />
        <receiver android:name=".TabletLockExpiryReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Lets the card reader check whether the old Helper app is still installed
         (Android 11+ hides other apps otherwise). Only this one package. -->
    <queries>
        <package android:name="com.transittrack.kioskhelper" />
    </queries>

    <!-- Managed combined-kiosk APK updates only; never used by the store app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Optional owner setup via adb; Android never grants this from a runtime prompt.
         Used only to enable our narrowly scoped USB accessibility helper. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" tools:targetApi="tiramisu" />
    <!-- Board by Bluetooth: the Bluetooth plugin adds its own permissions.
         This only marks the scan as never used for location, so Android 12+
         asks for "Nearby devices" alone, not location too. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Kiosk receiver permissions are explicit, independent of the phone BLE plugin. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="s" />
</manifest>

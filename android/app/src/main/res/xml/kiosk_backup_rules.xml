<?xml version="1.0" encoding="utf-8"?>
<!-- McSween Kiosk keeps nothing in backups (backups are off in the manifest
     too): its sign-in key, saved work, card list and kiosk lock state stay on
     this tablet, so a restored or new tablet is paired again. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

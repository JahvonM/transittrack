<?xml version="1.0" encoding="utf-8"?>
<!-- McSween Driver keeps nothing in phone backups: its pairing key and saved
     GPS stay on this phone, so a restored or new phone is paired again. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

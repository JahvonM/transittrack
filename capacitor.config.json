{
  "appId": "com.transittrack.app",
  "appName": "TransitTrack",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "url": "https://eager-transit-track-go.base44.app",
    "allowNavigation": [
      "eager-transit-track-go.base44.app"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0B0B0D",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Looking for buses...",
        "cancel": "Cancel",
        "availableDevices": "Pick your bus",
        "noDeviceFound": "No bus found nearby"
      }
    }
  },
  "android": {
    "loggingBehavior": "none"
  }
}

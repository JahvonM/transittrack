{
  "name": "Daily maintenance reminders",
  "description": "Emails admins/mechanics about maintenance that is due soon or overdue (maintenanceAlerts).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 11 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "namespace": "base44",
      "name": "daily-maintenance-reminders",
      "version": "1.0.0"
    },
    "do": [
      {
        "runMaintenanceAlerts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "maintenanceAlerts",
            "payload": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
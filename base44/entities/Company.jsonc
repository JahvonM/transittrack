{
  "name": "Company",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "access_code": {
      "type": "string"
    },
    "service_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "staff_bus",
          "taxi",
          "airport"
        ]
      }
    },
    "description": {
      "type": "string"
    },
    "boss_phone": {
      "type": "string",
      "description": "Owner/manager's phone number \u2014 SOS alerts are sent here (WhatsApp), not to staff."
    },
    "secretary_phone": {
      "type": "string",
      "description": "Secretary/dispatch phone number \u2014 SOS alerts are sent here (WhatsApp) alongside the boss."
    },
    "access_code_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy metadata; company codes are permanent and this expiry is no longer enforced."
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

{
  "name": "Company",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "access_code": {
      "type": "string"
    },
    "service_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "staff_bus",
          "taxi",
          "airport"
        ]
      }
    },
    "description": {
      "type": "string"
    },
    "boss_phone": {
      "type": "string",
      "description": "Owner/manager's phone number \u2014 SOS alerts are sent here (WhatsApp), not to staff."
    },
    "secretary_phone": {
      "type": "string",
      "description": "Secretary/dispatch phone number \u2014 SOS alerts are sent here (WhatsApp) alongside the boss."
    },
    "maintenance_reminder_days": {
      "type": "number",
      "default": 14,
      "description": "How many days (or km, for mileage-based schedules \u2014 reused as a generic threshold) before a MaintenanceSchedule is due that it starts showing as 'due soon'."
    },
    "auto_create_faults": {
      "type": "boolean",
      "default": true,
      "description": "When true, a failed driver inspection automatically creates a Fault record for mechanics, in addition to flagging needs_service."
    }
  },
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "FrontDeskSignIns",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "signature_url": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "full_name",
    "signed_at"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Fault",
  "type": "object",
  "required": [
    "vehicle_id",
    "title",
    "company_id"
  ],
  "properties": {
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "inspection",
        "manual"
      ],
      "default": "manual"
    },
    "inspection_id": {
      "type": "string",
      "description": "Set when source is 'inspection' \u2014 links back to the Inspection record that raised this fault."
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "default": "open"
    },
    "photo_url": {
      "type": "string"
    },
    "repair_required": {
      "type": "boolean",
      "default": false
    },
    "reported_by": {
      "type": "string"
    },
    "resolved_date": {
      "type": "string",
      "format": "date"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}
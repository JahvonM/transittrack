{
  "name": "GroupMessage",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "staff",
        "company",
        "dispatch",
        "mechanic"
      ],
      "default": "staff"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "driver",
        "staff",
        "admin",
        "company",
        "mechanic"
      ]
    },
    "sender_name": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "audio"
      ],
      "default": "text"
    },
    "media_url": {
      "type": "string"
    },
    "edited": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "vehicle_id",
    "sender_role",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.channel": "staff"
            },
            {
              "data.company_id": "{{user.data.company_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.channel": "company"
            },
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "user_condition": {
                "role": "company"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.channel": "mechanic"
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.channel": "staff"
            },
            {
              "data.company_id": "{{user.data.company_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.channel": "company"
            },
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "user_condition": {
                "role": "company"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.channel": "mechanic"
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
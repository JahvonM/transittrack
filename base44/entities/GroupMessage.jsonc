{
  "name": "GroupMessage",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "staff",
        "company",
        "dispatch",
        "mechanic"
      ],
      "default": "staff"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "driver",
        "staff",
        "admin",
        "company",
        "mechanic"
      ]
    },
    "sender_name": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "audio"
      ],
      "default": "text"
    },
    "media_url": {
      "type": "string"
    },
    "edited": {
      "type": "boolean",
      "default": false
    },
    "sender_id": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    }
  },
  "required": [
    "vehicle_id",
    "sender_role",
    "text"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
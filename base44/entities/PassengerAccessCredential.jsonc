{
  "name": "PassengerAccessCredential",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "token_hash": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "qr_token": {
      "type": "string",
      "description": "Permanent random boarding QR secret. Returned only to its signed-in owner, never in tablet directories."
    },
    "qr_hash": {
      "type": "string",
      "description": "Digest used to verify the permanent QR on a paired bus tablet."
    },
    "qr_issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "token_hash"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "StaffCheckIn",
  "type": "object",
  "properties": {
    "staff_name": {
      "type": "string"
    },
    "staff_picture_url": {
      "type": "string"
    },
    "card_tag": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "boarded",
        "off_board"
      ],
      "default": "boarded"
    },
    "boarded_at": {
      "type": "string",
      "format": "date-time"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "check_in_method": {
      "type": "string",
      "enum": [
        "nfc",
        "qr",
        "manual",
        "code"
      ],
      "default": "manual"
    },
    "client_request_id": {
      "type": "string"
    },
    "request_hash": {
      "type": "string"
    },
    "boarding_grant_hash": {
      "type": "string",
      "description": "Server-only digest binding a boarding authorization to its completed check-in. Sequential replay protection; not an atomic uniqueness constraint."
    },
    "device_id": {
      "type": "string"
    }
  },
  "required": [
    "card_tag",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "StaffCheckIn",
  "type": "object",
  "properties": {
    "staff_name": {
      "type": "string"
    },
    "staff_picture_url": {
      "type": "string"
    },
    "card_tag": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "boarded",
        "off_board"
      ],
      "default": "boarded"
    },
    "boarded_at": {
      "type": "string",
      "format": "date-time"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "check_in_method": {
      "type": "string",
      "enum": [
        "nfc",
        "qr",
        "manual",
        "code",
        "bluetooth"
      ],
      "default": "manual"
    },
    "client_request_id": {
      "type": "string"
    },
    "person_key": {
      "type": "string",
      "description": "Who tapped, as 'contact:<id>' or 'user:<id>': stays the same when their card is replaced."
    },
    "run_key": {
      "type": "string",
      "description": "The run this tap belongs to: 'shift:<DriverShift id>' while a driver's shift is open on the bus, else 'day:<bus>:<date>'."
    },
    "shift_id": {
      "type": "string"
    },
    "review_reason": {
      "type": "string",
      "description": "Why a person should look at this tap (exit with no boarding, cancelled card used offline, two tablets out of order...). Empty when normal."
    },
    "saved_offline": {
      "type": "boolean",
      "description": "The tablet saved this tap offline and sent it later. boarded_at is when it happened; created_date is when it arrived."
    },
    "request_hash": {
      "type": "string"
    },
    "boarding_grant_hash": {
      "type": "string",
      "description": "Server-only digest binding a boarding authorization to its completed check-in. Sequential replay protection; not an atomic uniqueness constraint."
    },
    "device_id": {
      "type": "string"
    }
  },
  "required": [
    "card_tag",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
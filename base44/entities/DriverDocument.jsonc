{
  "name": "DriverDocument",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "license",
        "insurance"
      ]
    },
    "file_uri": {
      "type": "string",
      "description": "Private file reference; viewed through a short-lived signed URL."
    },
    "file_name": {
      "type": "string"
    },
    "document_number": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "driver_id",
    "kind"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
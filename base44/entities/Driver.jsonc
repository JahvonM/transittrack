{
  "name": "Driver",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "nfc_card_uid": {
      "type": "string",
      "description": "Active staff card issued at Card issuing (uppercase hex)."
    },
    "phone_app_access": {
      "type": "boolean",
      "default": false,
      "description": "The driver may sign in to the driver phone app with this record's email."
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
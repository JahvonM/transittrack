{
  "name": "Driver",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique normalized username for driver phone sign-in; managed by privileged account provisioning."
    },
    "auth_user_id": {
      "type": "string",
      "description": "Immutable authentication user ID. Never store a password here."
    },
    "must_change_password": {
      "type": "boolean",
      "default": false,
      "description": "Server-enforced first-login/reset password change requirement."
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "nfc_card_uid": {
      "type": "string",
      "description": "Active staff card issued at Card issuing (uppercase hex)."
    },
    "phone_app_access": {
      "type": "boolean",
      "default": false,
      "description": "The driver's admin-controlled permission to use the phone app, regardless of whether they have an email address."
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
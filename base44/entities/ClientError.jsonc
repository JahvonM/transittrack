{
  "name": "ClientError",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "description": "Error message (truncated)"
    },
    "stack": {
      "type": "string",
      "description": "Stack trace / component stack (truncated)"
    },
    "url": {
      "type": "string",
      "description": "Page path where it happened"
    },
    "user_email": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "boundary | window | promise"
    },
    "device_id": {
      "type": "string",
      "description": "Driver or kiosk tablet it came from (blank for signed-in users)"
    },
    "emailed": {
      "type": "boolean",
      "default": false
    },
    "area": {
      "type": "string",
      "description": "Part of the app: Admin, Passenger app, Driver tablet, Boarding tablet, Driver phone app, Company manager, Mechanic"
    },
    "context": {
      "type": "object",
      "description": "App release, screen size, online, installed as an app, language"
    },
    "breadcrumbs": {
      "type": "array",
      "items": { "type": "object" },
      "description": "What happened just before: pages, taps, failed server calls ({t, type, text})"
    },
    "status": {
      "type": "string",
      "enum": ["new", "resolved"],
      "default": "new",
      "description": "Marked fixed in Admin → App errors"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "LostItemReport",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "reporter_name": {
      "type": "string"
    },
    "reporter_email": {
      "type": "string"
    },
    "contact": {
      "type": "string",
      "description": "Phone or email the reporter wants to be reached on."
    },
    "vehicle_name": {
      "type": "string",
      "description": "Bus the item was probably left on, if known."
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "found",
        "returned",
        "closed"
      ],
      "default": "open"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "description"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
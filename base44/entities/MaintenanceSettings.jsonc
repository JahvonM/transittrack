{
  "name": "MaintenanceSettings",
  "type": "object",
  "properties": {
    "auto_create_faults": {
      "type": "boolean",
      "default": true,
      "description": "Global, fleet-wide \u2014 a failed inspection (driver checklist or a mechanic's Run Inspection) auto-creates a Fault ticket. Only the mechanic team controls this, not individual companies."
    },
    "maintenance_reminder_days": {
      "type": "number",
      "default": 14,
      "description": "Global \u2014 days before a MaintenanceSchedule's due date that maintenanceAlerts sends a reminder email. Only the mechanic team controls this."
    },
    "enable_photo_attachments": {
      "type": "boolean",
      "default": true,
      "description": "Global \u2014 whether mechanics can attach photos to inspection items in Run Inspection. Only the mechanic team controls this."
    },
    "inspection_reminder_days": {
      "type": "number",
      "default": 1,
      "description": "Global \u2014 lead time (in days) before a recurring InspectionTemplate (one with frequency_days set) is due on a vehicle that inspectionAlerts sends a reminder email. Only the mechanic team controls this."
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}
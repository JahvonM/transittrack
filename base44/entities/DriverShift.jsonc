{
  "name": "DriverShift",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_email": {
      "type": "string"
    },
    "device_id": {
      "type": "string",
      "description": "Driver tablet (KioskDevice) that started the shift."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "client_request_id": {
      "type": "string"
    },
    "request_hash": {
      "type": "string"
    },
    "end_request_id": {
      "type": "string"
    },
    "end_request_hash": {
      "type": "string"
    }
  },
  "required": [
    "vehicle_id",
    "started_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

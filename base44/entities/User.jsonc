{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "company",
        "driver",
        "passenger",
        "staff",
        "mechanic"
      ],
      "default": "passenger"
    },
    "company_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "home_lat": {
      "type": "number"
    },
    "home_lng": {
      "type": "number"
    },
    "home_address": {
      "type": "string",
      "description": "Readable address of the pinned pickup location."
    },
    "work_lat": {
      "type": "number"
    },
    "work_lng": {
      "type": "number"
    },
    "nfc_tag_id": {
      "type": "string"
    },
    "access_code": {
      "type": "string",
      "description": "Persistent staff check-in code, assigned at the badge registry kiosk and typed on the bus boarding kiosk's keypad."
    },
    "one_time_code": {
      "type": "string",
      "description": "Short-lived self-service code a staff member generates from their own app when they forgot their NFC badge."
    },
    "one_time_code_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "whatsapp_linked": {
      "type": "boolean",
      "default": false
    },
    "skip_pickup_today": {
      "type": "boolean",
      "default": false
    },
    "skip_pickup_until": {
      "type": "string",
      "format": "date-time",
      "description": "Skip only applies until this moment (end of the day it was set)."
    },
    "late_snooze_active": {
      "type": "boolean",
      "default": false
    },
    "late_until": {
      "type": "string",
      "format": "date-time",
      "description": "Running-late flag only applies until this moment."
    },
    "favorite_stop": {
      "type": "string",
      "description": "Name of the passenger's usual pickup stop (matches a Route stop name)."
    },
    "stop_alerts": {
      "type": "boolean",
      "default": false,
      "description": "Send a push when a bus leaves the stop before favorite_stop."
    }
  },
  "required": []
}
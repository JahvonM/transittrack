{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "company",
        "driver",
        "passenger",
        "staff",
        "mechanic"
      ],
      "default": "passenger"
    },
    "company_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "home_lat": {
      "type": "number"
    },
    "home_lng": {
      "type": "number"
    },
    "work_lat": {
      "type": "number"
    },
    "work_lng": {
      "type": "number"
    },
    "nfc_tag_id": {
      "type": "string"
    },
    "access_code": {
      "type": "string",
      "description": "Persistent staff check-in code, assigned at the badge registry kiosk and typed on the bus boarding kiosk's keypad."
    },
    "one_time_code": {
      "type": "string",
      "description": "Short-lived self-service code a staff member generates from their own app when they forgot their NFC badge."
    },
    "one_time_code_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "whatsapp_linked": {
      "type": "boolean",
      "default": false
    },
    "skip_pickup_today": {
      "type": "boolean",
      "default": false
    },
    "late_snooze_active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": []
}
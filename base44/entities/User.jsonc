{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "company",
        "driver",
        "passenger",
        "staff"
      ],
      "default": "passenger"
    },
    "company_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    }
  }
}
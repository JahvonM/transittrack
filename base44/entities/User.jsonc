{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "company",
        "driver",
        "passenger",
        "staff"
      ],
      "default": "passenger"
    },
    "company_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "home_lat": {
      "type": "number"
    },
    "home_lng": {
      "type": "number"
    },
    "work_lat": {
      "type": "number"
    },
    "work_lng": {
      "type": "number"
    },
    "nfc_tag_id": {
      "type": "string"
    },
    "whatsapp_linked": {
      "type": "boolean",
      "default": false
    },
    "skip_pickup_today": {
      "type": "boolean",
      "default": false
    },
    "late_snooze_active": {
      "type": "boolean",
      "default": false
    }
  }
}
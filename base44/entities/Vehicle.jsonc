{
  "name": "Vehicle",
  "type": "object",
  "required": [
    "name",
    "type",
    "company_id"
  ],
  "properties": {
    "capacity": {
      "type": "number"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "current_lat": {
      "type": "number"
    },
    "current_lng": {
      "type": "number"
    },
    "current_odometer": {
      "type": "number",
      "description": "Odometer reading in km \u2014 also the single source of truth for MaintenanceSchedule's mileage-based due calculations (merged from FleetPilot's separate 'mileage' field)."
    },
    "driver_email": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_pin": {
      "type": "string"
    },
    "entry_code": {
      "type": "string"
    },
    "heading": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "last_location_update": {
      "format": "date-time",
      "type": "string"
    },
    "last_ping_logged_at": {
      "description": "Last time a LocationPing history point was recorded for this vehicle \u2014 throttles history logging to roughly once a minute.",
      "format": "date-time",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "near_stop_id": {
      "description": "Name of the route stop the vehicle is currently within arrival radius of, if any \u2014 used to detect arrival/departure transitions for place alerts without re-alerting every GPS tick.",
      "type": "string"
    },
    "plate_number": {
      "type": "string"
    },
    "remote_tracking_lock": {
      "default": false,
      "type": "boolean"
    },
    "route_id": {
      "type": "string"
    },
    "speed": {
      "type": "number"
    },
    "status": {
      "default": "offline",
      "enum": [
        "offline",
        "idle",
        "on_trip",
        "speeding",
        "emergency"
      ],
      "type": "string"
    },
    "tracking_active": {
      "default": false,
      "type": "boolean"
    },
    "trail": {
      "items": {
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "t": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "type": {
      "default": "bus",
      "enum": [
        "bus",
        "taxi"
      ],
      "type": "string"
    },
    "wired_gps_connected": {
      "default": false,
      "type": "boolean"
    },
    "fleet_number": {
      "type": "string",
      "description": "Vehicle number / internal fleet code (e.g. BUS001), distinct from plate_number."
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "vin": {
      "type": "string",
      "description": "Chassis number (VIN)."
    },
    "engine": {
      "type": "string"
    },
    "transmission": {
      "type": "string"
    },
    "hours": {
      "type": "number",
      "default": 0,
      "description": "Engine hours, tracked separately from odometer km."
    },
    "fuel_type": {
      "type": "string"
    },
    "last_inspection_date": {
      "type": "string",
      "format": "date"
    },
    "in_service": {
      "type": "boolean",
      "default": true,
      "description": "Whether this vehicle is an active part of the fleet for maintenance purposes \u2014 separate from the live dispatch 'status' field (a vehicle can be in_service but currently offline)."
    },
    "model_3d": {
      "type": "string",
      "description": "Which 3D model draws this vehicle on maps (see src/lib/vehicleModels.js), e.g. city_bus, coach, school_bus, taxi."
    }
  },
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "company"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.driver_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        }
      ]
    }
  }
}
{
  "name": "Vehicle",
  "type": "object",
  "required": [
    "name",
    "type"
  ],
  "properties": {
    "capacity": {
      "type": "number"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "current_lat": {
      "type": "number"
    },
    "current_lng": {
      "type": "number"
    },
    "current_odometer": {
      "type": "number",
      "description": "Odometer reading in km — also the single source of truth for MaintenanceSchedule's mileage-based due calculations (merged from FleetPilot's separate 'mileage' field)."
    },
    "driver_email": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_pin": {
      "type": "string"
    },
    "entry_code": {
      "type": "string"
    },
    "heading": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "last_location_update": {
      "format": "date-time",
      "type": "string"
    },
    "last_ping_logged_at": {
      "description": "Last time a LocationPing history point was recorded for this vehicle — throttles history logging to roughly once a minute.",
      "format": "date-time",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "near_stop_id": {
      "description": "Name of the route stop the vehicle is currently within arrival radius of, if any — used to detect arrival/departure transitions for place alerts without re-alerting every GPS tick.",
      "type": "string"
    },
    "road_next_stop": {
      "description": "On a route with a drawn road: the position (0 = first) of the next stop the bus reaches, in the bus's own stop order. Sent by the bus tablet. Passengers count stops away from it; it never holds anyone's pickup location. Cleared when a trip starts.",
      "type": "number"
    },
    "plate_number": {
      "type": "string"
    },
    "remote_tracking_lock": {
      "default": false,
      "type": "boolean"
    },
    "route_id": {
      "type": "string"
    },
    "speed": {
      "type": "number"
    },
    "status": {
      "default": "offline",
      "enum": [
        "offline",
        "idle",
        "on_trip",
        "speeding",
        "emergency"
      ],
      "type": "string"
    },
    "tracking_active": {
      "default": false,
      "type": "boolean"
    },
    "trail": {
      "items": {
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "t": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "type": {
      "default": "bus",
      "enum": [
        "bus",
        "taxi"
      ],
      "type": "string"
    },
    "backup_gps_driver_email": {
      "type": "string",
      "description": "Backup GPS: while set, this driver's phone app sends the bus position during their open shift (dispatch turns it on when the bus tablet fails)."
    },
    "backup_gps_since": {
      "type": "string",
      "format": "date-time"
    },
    "wired_gps_connected": {
      "default": false,
      "type": "boolean"
    },
    "fleet_number": {
      "type": "string",
      "description": "Vehicle number / internal fleet code (e.g. BUS001), distinct from plate_number."
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "vin": {
      "type": "string",
      "description": "Chassis number (VIN)."
    },
    "engine": {
      "type": "string"
    },
    "transmission": {
      "type": "string"
    },
    "hours": {
      "type": "number",
      "default": 0,
      "description": "Engine hours, tracked separately from odometer km."
    },
    "fuel_type": {
      "type": "string"
    },
    "last_inspection_date": {
      "type": "string",
      "format": "date"
    },
    "in_service": {
      "type": "boolean",
      "default": true,
      "description": "Whether this vehicle is an active part of the fleet for maintenance purposes — separate from the live dispatch 'status' field (a vehicle can be in_service but currently offline)."
    },
    "model_3d": {
      "type": "string",
      "description": "Which 3D model draws this vehicle on maps (see src/lib/vehicleModels.js), e.g. city_bus, coach, school_bus, taxi."
    },
    "trip_direction": {
      "type": "string",
      "enum": [
        "to_work",
        "to_home"
      ],
      "default": "to_work",
      "description": "Current staff transport direction, selected by the authorized driver."
    },
    "trip_direction_started_at": {
      "type": "string",
      "description": "Server timestamp identifying the current staff journey."
    },
    "return_pickup_state": {
      "type": "string",
      "enum": [
        "pending",
        "near",
        "arrived",
        "departed"
      ],
      "description": "Company boarding state for a return journey."
    },
    "return_pickup_date": {
      "type": "string",
      "description": "Server-local service date for resetting company boarding state."
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

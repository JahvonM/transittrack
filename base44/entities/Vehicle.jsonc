{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "plate_number": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "bus",
        "taxi"
      ],
      "default": "bus"
    },
    "capacity": {
      "type": "number"
    },
    "current_lat": {
      "type": "number"
    },
    "current_lng": {
      "type": "number"
    },
    "heading": {
      "type": "number"
    },
    "speed": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "offline",
        "idle",
        "on_trip"
      ],
      "default": "offline"
    },
    "last_location_update": {
      "type": "string",
      "format": "date-time"
    },
    "driver_email": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type",
    "company_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "company"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.driver_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
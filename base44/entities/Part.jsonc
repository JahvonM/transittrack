{
  "name": "Part",
  "type": "object",
  "required": [
    "part_name"
  ],
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "part_name": {
      "type": "string"
    },
    "oem_number": {
      "type": "string"
    },
    "aftermarket_number": {
      "type": "string"
    },
    "vehicle_compatibility": {
      "type": "string",
      "description": "e.g. Toyota Hiace"
    },
    "category": {
      "type": "string"
    },
    "quantity_in_stock": {
      "type": "number",
      "default": 0
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "supplier": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo of the part."
    },
    "guide_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The Bus library pages (VehicleGuide ids) of the bus models this part fits. Set by administrators and mechanics."
    },
    "min_stock": {
      "type": "number",
      "description": "Warn when the stock falls to this or below; empty for no warning."
    },
    "bin_location": {
      "type": "string",
      "description": "Where it is kept, e.g. Shelf B2."
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
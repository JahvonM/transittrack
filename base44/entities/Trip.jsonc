{
  "name": "Trip",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "plate_number": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "route_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "driver_email": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "passenger_name": {
      "type": "string"
    },
    "passenger_phone": {
      "type": "string"
    },
    "pickup_name": {
      "type": "string"
    },
    "pickup_lat": {
      "type": "number"
    },
    "pickup_lng": {
      "type": "number"
    },
    "dropoff_name": {
      "type": "string"
    },
    "dropoff_lat": {
      "type": "number"
    },
    "dropoff_lng": {
      "type": "number"
    },
    "scheduled_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "on_the_way",
        "arrived",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "arrived_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "pickup_signature_url": {
      "type": "string"
    },
    "pickup_signed_by": {
      "type": "string"
    },
    "pickup_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "dropoff_signature_url": {
      "type": "string"
    },
    "dropoff_signed_by": {
      "type": "string"
    },
    "dropoff_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "airport_pickup",
        "airport_dropoff",
        "hotel_tour",
        "staff_run",
        "transfer"
      ],
      "description": "Kind of job; trips made before job types read as a transfer"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "pickup_address": {
      "type": "string"
    },
    "dropoff_address": {
      "type": "string"
    },
    "flight_number": {
      "type": "string"
    },
    "flight_time": {
      "type": "string",
      "format": "date-time",
      "description": "Landing time (airport pickup) or departure time (airport drop-off), as told to dispatch"
    },
    "guests": {
      "type": "integer"
    },
    "luggage": {
      "type": "integer"
    },
    "notes": {
      "type": "string"
    },
    "stops": {
      "type": "array",
      "description": "Tour stops in order",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "reached_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "When the job should be finished; used to warn about overlapping jobs"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "XCD"
    },
    "invoice_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "pickup_signature_uri": {
      "type": "string",
      "description": "Private file; opened through jobBilling"
    },
    "pickup_signed_guests": {
      "type": "integer"
    },
    "pickup_signed_lat": {
      "type": "number"
    },
    "pickup_signed_lng": {
      "type": "number"
    },
    "pickup_signature_request_id": {
      "type": "string"
    },
    "dropoff_signature_uri": {
      "type": "string",
      "description": "Private file; opened through jobBilling"
    },
    "dropoff_signed_guests": {
      "type": "integer"
    },
    "dropoff_signed_lat": {
      "type": "number"
    },
    "dropoff_signed_lng": {
      "type": "number"
    },
    "dropoff_signature_request_id": {
      "type": "string"
    },
    "pickup_signed_role": {
      "type": "string",
      "enum": [
        "guest",
        "reception"
      ],
      "description": "Who signed for the pickup: a guest, or the hotel's front desk"
    },
    "dropoff_signed_role": {
      "type": "string",
      "enum": [
        "guest",
        "reception"
      ],
      "description": "Who signed for the drop-off: a guest, or the hotel's front desk"
    },
    "driver_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "pickup_arrived_at": {
      "type": "string",
      "format": "date-time"
    },
    "shared_with_company": {
      "type": "boolean",
      "default": false,
      "description": "A job shown in the bus company's portal, with the bus's location while the job is under way. Set by dispatch; on for jobs the company asked for."
    }
  },
  "required": [
    "company_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

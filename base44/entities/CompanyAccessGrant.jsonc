      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "token_hash": {
      "type": "string"
    },
    "code_hash": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    }
  },
  "rls": {

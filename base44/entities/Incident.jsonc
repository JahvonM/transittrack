{
  "name": "Incident",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "speeding",
        "emergency",
        "breakdown",
        "other"
      ],
      "default": "other"
    },
    "details": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "company_id"
  ]
}
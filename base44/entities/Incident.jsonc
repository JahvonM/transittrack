{
  "name": "Incident",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "speeding",
        "emergency",
        "breakdown",
        "accident",
        "delay",
        "other"
      ],
      "default": "other"
    },
    "details": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "resolved"
      ],
      "default": "open"
    }
  },
  "required": [
    "type",
    "company_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
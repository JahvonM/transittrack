{
  "name": "KioskDevice",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "kiosk_type": {
      "type": "string",
      "enum": [
        "bus_boarding",
        "front_desk",
        "badge_registry",
        "driver"
      ],
      "default": "bus_boarding"
    },
    "pairing_code": {
      "type": "string"
    },
    "paired": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "device_info": {
      "type": "string",
      "description": "Reported by the tablet: which map it can draw (full/basic), WebGL 2 support and browser."
    },
    "directory_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an admin last sent the staff card list to this tablet; the tablet re-downloads it on its next check-in."
    }
  },
  "required": [
    "label",
    "kiosk_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        }
      ]
    }
  }
}
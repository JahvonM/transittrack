{
  "name": "KioskDevice",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "device_info": {
      "description": "Reported by the tablet: which map it can draw (full/basic), WebGL 2 support and browser.",
      "type": "string"
    },
    "directory_sent_at": {
      "description": "When an admin last sent the staff card list to this tablet; the tablet re-downloads it on its next check-in.",
      "format": "date-time",
      "type": "string"
    },
    "helper_health": {
      "description": "Reported by the TransitTrack Helper Android app on the tablet (via the kiosk/driver page heartbeat): helper version, battery %, charging, parked, card reader state, last card time, USB GPS state, and when it was reported.",
      "properties": {
        "battery": {
          "type": "number"
        },
        "charging": {
          "type": "boolean"
        },
        "gps": {
          "type": "string"
        },
        "last_card_at": {
          "type": "string"
        },
        "parked": {
          "type": "boolean"
        },
        "reader": {
          "type": "string"
        },
        "reported_at": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "kiosk_type": {
      "default": "bus_boarding",
      "enum": [
        "bus_boarding",
        "front_desk",
        "badge_registry",
        "driver"
      ],
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "type": "string"
    },
    "paired": {
      "default": false,
      "type": "boolean"
    },
    "pairing_code": {
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "revoked"
      ],
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    }
  },
  "required": [
    "label",
    "kiosk_type"
  ],
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company"
          }
        }
      ]
    }
  }
}
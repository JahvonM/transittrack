{
  "name": "KioskDevice",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "device_info": {
      "description": "Reported by the tablet: which map it can draw (full/basic), WebGL 2 support and browser.",
      "type": "string"
    },
    "update_requested_at": {
      "description": "When an admin pressed Send update; the tablet reloads to the newest version the next time it is idle.",
      "format": "date-time",
      "type": "string"
    },
    "directory_sent_at": {
      "description": "When an admin last sent the staff card list to this tablet; the tablet re-downloads it on its next check-in.",
      "format": "date-time",
      "type": "string"
    },
    "app_health": {
      "type": "object",
      "description": "Reported by the TransitTrack app on the tablet every heartbeat: build, online, uploads waiting (GPS points, check-ins, other saved work), last GPS fix, card reader in use, saved staff list.",
      "properties": {
        "reported_at": {
          "type": "string",
          "format": "date-time"
        },
        "build": {
          "type": "string"
        },
        "online": {
          "type": "boolean"
        },
        "queued_gps": {
          "type": "number"
        },
        "queued_checkins": {
          "type": "number"
        },
        "queued_jobs": {
          "type": "number"
        },
        "last_gps_fix": {
          "type": "string",
          "format": "date-time"
        },
        "reader": {
          "type": "string"
        },
        "saved_list_at": {
          "type": "string",
          "format": "date-time"
        },
        "saved_list_count": {
          "type": "number"
        }
      }
    },
    "helper_health": {
      "description": "Reported by the TransitTrack Helper Android app on the tablet (via the kiosk/driver page heartbeat): helper version, battery %, charging, parked, card reader state, last card time, USB GPS state, Wi-Fi hotspot state, and when it was reported.",
      "properties": {
        "battery": {
          "type": "number"
        },
        "charging": {
          "type": "boolean"
        },
        "gps": {
          "type": "string"
        },
        "hotspot": {
          "type": "string"
        },
        "last_card_at": {
          "type": "string"
        },
        "parked": {
          "type": "boolean"
        },
        "reader": {
          "type": "string"
        },
        "reported_at": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "kiosk_type": {
      "default": "bus_boarding",
      "enum": [
        "bus_boarding",
        "front_desk",
        "badge_registry",
        "driver"
      ],
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "type": "string"
    },
    "paired": {
      "default": false,
      "type": "boolean"
    },
    "pairing_code": {
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "revoked"
      ],
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "pairing_expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "label",
    "kiosk_type"
  ],
  "type": "object",
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
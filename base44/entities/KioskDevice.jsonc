{
  "name": "KioskDevice",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "device_info": {
      "description": "Reported by the tablet: which map it can draw (full/basic), WebGL 2 support and browser.",
      "type": "string"
    },
    "update_requested_at": {
      "description": "When an admin pressed Send update; the tablet reloads to the newest version the next time it is idle.",
      "format": "date-time",
      "type": "string"
    },
    "directory_sent_at": {
      "description": "When an admin last sent the staff card list to this tablet; the tablet re-downloads it on its next check-in.",
      "format": "date-time",
      "type": "string"
    },
    "app_health": {
      "type": "object",
      "description": "Reported by the TransitTrack app on the tablet every heartbeat: build, online, uploads waiting (GPS points, check-ins, other saved work), last GPS fix, the latitude/longitude the tablet's GPS is getting, card reader in use, saved staff list.",
      "properties": {
        "reported_at": {
          "type": "string",
          "format": "date-time"
        },
        "build": {
          "type": "string"
        },
        "online": {
          "type": "boolean"
        },
        "queued_gps": {
          "type": "number"
        },
        "queued_checkins": {
          "type": "number"
        },
        "queued_jobs": {
          "type": "number"
        },
        "last_gps_fix": {
          "type": "string",
          "format": "date-time"
        },
        "lat": {
          "type": "number",
          "description": "Latitude of the last GPS fix this tablet reported."
        },
        "lng": {
          "type": "number",
          "description": "Longitude of the last GPS fix this tablet reported."
        },
        "reader": {
          "type": "string"
        },
        "saved_list_at": {
          "type": "string",
          "format": "date-time"
        },
        "saved_list_count": {
          "type": "number"
        }
      }
    },
    "helper_health": {
      "description": "Reported by the TransitTrack Helper Android app on the tablet (via the kiosk/driver page heartbeat): helper version, battery %, charging, parked, card reader state, last card time, USB GPS state, Wi-Fi hotspot state, and when it was reported.",
      "properties": {
        "battery": {
          "type": "number"
        },
        "charging": {
          "type": "boolean"
        },
        "gps": {
          "type": "string"
        },
        "hotspot": {
          "type": "string"
        },
        "hotspot_always": {
          "description": "Driver tablets (Helper 1.9+): Admin set the hotspot to stay on all the time.",
          "type": "boolean"
        },
        "wifi": {
          "description": "Boarding tablets (Helper 1.9+): the Wi-Fi network it is on, the latest scan of nearby networks, and the latest network change from Admin.",
          "type": "object",
          "properties": {
            "ssid": {
              "type": "string"
            },
            "bars": {
              "type": "number"
            },
            "networks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ssid": {
                    "type": "string"
                  },
                  "bars": {
                    "type": "number"
                  },
                  "lock": {
                    "type": "string"
                  }
                }
              }
            },
            "scanned_at": {
              "type": "string",
              "format": "date-time"
            },
            "join": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "ssid": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        },
        "last_card_at": {
          "type": "string"
        },
        "parked": {
          "type": "boolean"
        },
        "reader": {
          "type": "string"
        },
        "reported_at": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "kiosk_type": {
      "default": "bus_boarding",
      "enum": [
        "bus_boarding",
        "front_desk",
        "badge_registry",
        "driver"
      ],
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "type": "string"
    },
    "paired": {
      "default": false,
      "type": "boolean"
    },
    "pairing_code": {
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "revoked"
      ],
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "pairing_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "network_command": {
      "description": "Admin \u2192 Kiosk tablets: a pending Wi-Fi or hotspot command for this tablet (a Wi-Fi change includes its password). Not returned by entityAccess; given only to the tablet on check-in and deleted once the tablet confirms it, or after 10 minutes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "ssid": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "always_on": {
          "type": "boolean"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "network_status": {
      "description": "What Admin shows about the latest Wi-Fi or hotspot command (never a password): waiting, sent, delivered or expired.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "ssid": {
          "type": "string"
        },
        "always_on": {
          "type": "boolean"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "requested_by": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "delivered_at": {
          "type": "string",
          "format": "date-time"
        },
        "expired_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "label",
    "kiosk_type"
  ],
  "type": "object",
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
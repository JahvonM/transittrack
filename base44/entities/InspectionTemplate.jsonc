{
  "name": "InspectionTemplate",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "e.g. Daily, Weekly, Monthly, Service"
    },
    "category": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "description": "Optional \u2014 blank means available to every company (true for the default seeded templates)."
    },
    "company_name": {
      "type": "string"
    },
    "frequency_days": {
      "type": "number",
      "description": "Optional \u2014 how often (in days) this template should be run per vehicle. Set this to have inspectionAlerts remind mechanics when a vehicle is overdue. Leave blank/0 to exclude this template from reminders (e.g. a one-off or ad-hoc checklist)."
    },
    "audience": {
      "type": "string",
      "enum": [
        "mechanic",
        "driver",
        "both"
      ],
      "default": "mechanic",
      "description": "Who runs this inspection: mechanics (Run Inspection page), drivers (driver tablet app), or both."
    },
    "driver_trigger": {
      "type": "string",
      "enum": [
        "start_of_day",
        "at_times",
        "shift_start",
        "shift_end",
        "on_demand"
      ],
      "default": "start_of_day",
      "description": "When the inspection appears in the driver app."
    },
    "driver_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Days of the week it appears (0=Sunday \u2026 6=Saturday). Empty means every day."
    },
    "driver_times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "For the 'at_times' trigger: HH:MM times of day it becomes due (each time is a separate round, so it can be due several times a day)."
    },
    "driver_vehicle_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Only send to these buses. Empty means every bus (in the template's company)."
    },
    "xray_layout": {
      "type": "string",
      "enum": [
        "front_engine",
        "minibus",
        "city_rear"
      ],
      "default": "front_engine",
      "description": "Which bus drawing the X-ray walk-around uses."
    },
    "driver_from_time": {
      "type": "string",
      "description": "Optional HH:MM \u2014 only appears from this time of day on."
    },
    "driver_required": {
      "type": "boolean",
      "default": true,
      "description": "Driver must finish it before driving (no skip)."
    },
    "driver_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set by 'Send to drivers now' \u2014 the inspection pops up on every matching driver tablet until done after this time."
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section_name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item_name": {
                  "type": "string"
                },
                "critical": {
                  "type": "string",
                  "enum": [
                    "Low",
                    "Medium",
                    "High",
                    "Critical"
                  ],
                  "default": "Medium"
                },
                "requires_photo": {
                  "type": "boolean",
                  "default": false
                },
                "zone": {
                  "type": "string",
                  "description": "Bus part shown on the X-ray view (blank = worked out from the item name)."
                },
                "instructions": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "DeviceCredential",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string"
    },
    "token_hash": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "kiosk_type": {
      "type": "string"
    },
    "pairing_code_hash": {
      "type": "string"
    },
    "issued_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    }
  },
  "required": [
    "device_id",
    "token_hash",
    "issued_at",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
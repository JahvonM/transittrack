{
  "name": "Inspection",
  "type": "object",
  "properties": {
    "driver_name": {
      "type": "string"
    },
    "driver_email": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ],
      "default": "passed"
    },
    "checklist": {
      "type": "object",
      "properties": {
        "brakes": {
          "type": "boolean"
        },
        "tires": {
          "type": "boolean"
        },
        "lights": {
          "type": "boolean"
        },
        "fluids": {
          "type": "boolean"
        },
        "cleanliness": {
          "type": "boolean"
        }
      }
    },
    "odometer_reading": {
      "type": "number"
    },
    "fuel_level": {
      "type": "number"
    },
    "needs_service": {
      "type": "boolean",
      "default": false
    },
    "service_notes": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "template_name": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section_name": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "critical": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          }
        }
      }
    },
    "client_request_id": {
      "type": "string"
    },
    "request_hash": {
      "type": "string"
    },
    "request_actor_id": {
      "type": "string"
    }
  },
  "required": [
    "driver_name",
    "vehicle_id",
    "company_id",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

// Cloudflare hosting for the Supabase build of the app (step 7 of the move
// from Base44). The `transittrack` Worker serves the built files in dist/;
// any address that isn't a file gets index.html, so the app's own pages load.
// Kept out of the repository root so Base44's own build never picks it up.
//
// Worker -> Settings -> Build:
//   Build command:  npm run build:supabase
//   Deploy command: npx wrangler deploy --config cloudflare/wrangler.jsonc
//   Build variable: NODE_VERSION = 22
{
  "name": "transittrack",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "not_found_handling": "single-page-application"
  }
}
